{
  "name": "@apsolut/dbeaver-mcp",
  "version": "1.6.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "MCP plugin: query DBeaver Community connections, including SSH-tunneled Postgres. Works with Grok, Claude Code, Codex, and Agy.",
  "bin": {
    "dbeaver-mcp": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "cli": "node src/index.js --cli",
    "doctor": "node scripts/doctor.mjs",
    "setup": "npm install && node scripts/install-hosts.mjs",
    "install-hosts": "node scripts/install-hosts.mjs",
    "test": "node --test"
  },
  "files": [
    "src/",
    "scripts/",
    "skills/",
    "commands/",
    ".mcp.json",
    "README.md",
    "CHANGELOG.md",
    "HOWTO.md",
    "SECURITY.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "apsolut",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apsolut/dbeaver-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/apsolut/dbeaver-mcp/issues"
  },
  "homepage": "https://github.com/apsolut/dbeaver-mcp#readme",
  "keywords": [
    "dbeaver",
    "postgres",
    "ssh",
    "mcp",
    "grok",
    "claude",
    "codex",
    "antigravity"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "pg": "^8.16.0",
    "ssh2": "^1.16.0",
    "zod": "^3.24.2"
  }
}
